PORT=3000
NODE_ENV=production
PUBLIC_SITE_URL=https://nixmixaudio.com
API_PUBLIC_URL=https://nixmixaudio-backend.nixmixaudio.workers.dev
FRONTEND_URL=https://nixmixaudio.com,https://www.nixmixaudio.com

GOOGLE_CLIENT_ID=
SESSION_SECRET=
ADMIN_PASSWORD=

RESEND_API_KEY=
RESEND_FROM=NixMix Audio <support@nixmixaudio.com>
SUPPORT_EMAIL=support@nixmixaudio.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Use persistent mounted storage in production.
DATA_DIR=/var/data/nixmix
DOWNLOADS_DIR=/var/data/nixmix/downloads
